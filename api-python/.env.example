# Copier en .env pour le dev local.
PROJECT_ID=french-forge-600

# CORS — origines autorisées (JSON list). En prod : le domaine Hosting.
# ALLOWED_ORIGINS=["https://trainer.french-forge.com","http://localhost:5173"]

# Postgres (Neon serverless) — EN LOCAL uniquement.
#   - utilise l'endpoint POOLER (host `...-pooler.<region>.aws.neon.tech`)
#   - garde `sslmode=require`
#   - `postgresql://` est accepté tel quel (brokkr force le driver psycopg v3) ;
#     `postgresql+psycopg://` marche aussi.
# EN PROD (Cloud Run, plus tard) : NE PAS utiliser ce fichier — DATABASE_URL est
# assemblée depuis le secret `brokkr-db-password` + host/db/user en env.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
