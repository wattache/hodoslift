{
  "name": "eitri",
  "private": true,
  "version": "1.0.11",
  "type": "module",
  "description": "Eitri — front French Forge Trainer (API brokkr, Firebase auth only)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/refuser-emulateur.mjs && node scripts/garde-publication.mjs && tsc -b && vite build && node scripts/version-sw.mjs",
    "lint": "eslint . --max-warnings 41",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:reel": "playwright test --config playwright.reel.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:reel:stack": "bash scripts/e2e-reel.sh",
    "types:brokkr": "openapi-typescript ../api-python/docs/openapi.json -o src/api/brokkr.gen.ts",
    "fixtures:brokkr": "cp ../api-python/docs/moyennes-par-serie.json src/lib/__fixtures__/moyennes-par-serie.json",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@sentry/react": "^10.70.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "knip": "^5.88.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  }
}
